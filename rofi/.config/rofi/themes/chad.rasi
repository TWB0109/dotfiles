@theme "/dev/null"

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}

* {
    /* Backgrounds updated with 'cc' for 80% opacity */
    gruvboxDark-bg-col:      #282828cc; 
    gruvboxLight-bg-col:     #f2e5bccc;
    
    /* Other variables remain the same */
    gruvboxDark-dark-black:  #1e2122;
    gruvboxDark-border-col:  #b8bb26;
    gruvboxDark-selected-col: #b8bb26;
    gruvboxDark-blue:        #83a598;
    gruvboxDark-fg-col:      #d5c4a1;
    gruvboxDark-fg-col-inverted: #282828;
    gruvboxDark-fg-col2:     #282828;

    gruvboxLight-dark-black: #1e2122;
    gruvboxLight-border-col: #79740e;
    gruvboxLight-selected-col: #79740e;
    gruvboxLight-blue:       #076678;
    gruvboxLight-fg-col:     #3c3836;
    gruvboxLight-fg-col-inverted: #f2e5bc;
    gruvboxLight-fg-col2:    #79740e;
    width: 600;
}

window {
    padding: 20px;
    height: 360px;
    border: 0px;
    border-color: @gruvboxLight-border-col;
    /* This will now be transparent */
    background-color: @gruvboxLight-bg-col;
    border-radius: 12;
    transparency: "real";
}

mainbox {
    padding: 5px;
    border-radius: 13px;
    /* Ensure this is also using the transparent variable */
    background-color: transparent;
}

inputbar {
    children: [prompt,entry];
    background-color: transparent;
    border-radius: 5px;
    padding: 2px;
}

prompt {
    background-color: @gruvboxLight-selected-col;
    padding: 10px;
    text-color: @gruvboxLight-fg-col-inverted;
    border-radius: 3px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 10px;
    text-color: @gruvboxLight-fg-col;
    background-color: transparent;
}

listview {
    border: 0px 0px 0px;
    padding: 6px 0px 0px;
    columns: 2;
    background-color: transparent;
}

element {
    padding: 5px;
    background-color: transparent;
    text-color: @gruvboxLight-fg-col  ;
}

element-icon {
    size: 25px;
}

element selected {
    background-color:  @gruvboxLight-selected-col;
    border-radius: 0.2em;
    text-color: @gruvboxLight-fg-col-inverted;
}

message {
    background-color: @gruvboxLight-bg-col;
    text-color: @gruvboxLight-fg-col;
}

